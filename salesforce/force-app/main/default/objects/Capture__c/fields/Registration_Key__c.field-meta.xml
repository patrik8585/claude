<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Registration_Key__c</fullName>
    <description>Normalised registration number used for matching.</description>
    <label>Registration Key</label>
    <formula>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(UPPER(Registration_Number__c), "-", ""), " ", ""), "/", "")</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <required>false</required>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
