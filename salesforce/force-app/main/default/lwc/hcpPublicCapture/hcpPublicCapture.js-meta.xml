<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>HCP Public Capture</masterLabel>
    <description>Public QR / kiosk capture form and double opt-in confirmation page (guest user).</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="eventId" type="String" label="Default event Id" description="Used when the URL has no ?e= parameter." />
            <property name="defaultMode" type="String" label="Default mode" datasource="form,kiosk" default="form" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
